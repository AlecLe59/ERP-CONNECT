<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ErpConnect.Service</RootNamespace>
    <AssemblyName>ErpConnect.Service</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ErpConnect.Core\ErpConnect.Core.csproj" />
    <ProjectReference Include="..\ErpConnect.Contracts\ErpConnect.Contracts.csproj" />
    <ProjectReference Include="..\ErpConnect.Security\ErpConnect.Security.csproj" />
    <ProjectReference Include="..\ErpConnect.Storage\ErpConnect.Storage.csproj" />
    <ProjectReference Include="..\ErpConnect.Rpc\ErpConnect.Rpc.csproj" />
    <ProjectReference Include="..\ErpConnect.Engine\ErpConnect.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ErpConnect.Service.IntegrationTests" />
    <InternalsVisibleTo Include="ErpConnect.SecurityTests" />
  </ItemGroup>
</Project>
