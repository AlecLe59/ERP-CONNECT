<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Conventions de nommage des tests (soulignés), méthodes publiques non statiques, ConfigureAwait inutile dans xUnit. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1822;CA1861;CA1063;CA1816;CA2000;CA5394;CA1859;CA1849;CA1835;CA2100;CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
