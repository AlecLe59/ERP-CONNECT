root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,json,yml,yaml,md,css}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.CA2100.severity = error   # SQL non paramétré
dotnet_diagnostic.CA5350.severity = error   # algorithme cryptographique faible
dotnet_diagnostic.CA5351.severity = error   # algorithme cryptographique cassé
